# Backend
# Create a Groq API key and choose a model enabled for that key.
# Model availability and usage charges depend on your Groq account.
GROQ_API_KEY= 
GROQ_MODEL= llama-3.3-70b-versatile
GROQ_RATE_LIMIT_TPM=1200
DATABASE_PATH=./data/bioextract.db
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=25
CORS_ORIGINS=http://localhost:5173
